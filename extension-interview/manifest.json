{
  "manifest_version": 3,
  "name": "UrBox Interview - thu buổi phỏng vấn",
  "version": "0.1.0",
  "description": "Thu buổi phỏng vấn online (mic = người phỏng vấn, tiếng tab = ứng viên) rồi gửi về UrBox Interview để chép lời và chấm điểm.",
  "permissions": ["tabCapture", "offscreen", "storage", "scripting", "tabs"],
  "host_permissions": [
    "https://urbox-meeting-api.onrender.com/*",
    "http://localhost:8080/*",
    "http://127.0.0.1:8080/*",
    "https://meet.google.com/*",
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*",
    "https://*.zoom.us/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://*.zoom.us/*"
      ],
      "js": ["mute-watch.js"],
      "run_at": "document_idle"
    }
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "UrBox Interview - thu buổi phỏng vấn" }
}
