# Biến môi trường cho server nhà mình (Docker). Chép thành /opt/meeting-copilot/prod.env trên server, điền giá trị thật.
# KHÔNG đưa prod.env vào repo. Danh sách đầy đủ và giá trị mặc định: README, render.yaml, .env.example.

# --- Bắt buộc ---
AUTH_REQUIRED=1
AUTH_SECRET=                       # chuỗi ngẫu nhiên dài (openssl rand -hex 32); đổi là mọi người phải đăng nhập lại
ALLOWED_DOMAIN=urbox.vn
AUTH_ADMIN_EMAILS=                  # email quản trị viên, cách nhau bằng dấu phẩy
PUBLIC_BASE_URL=https://meeting.urbox.vn   # địa chỉ công khai của server (Google redirect, Recall gửi âm thanh về)
CORS_ORIGINS=https://meeting.urbox.vn
MONGODB_URL=                        # MongoDB Atlas (mongodb+srv://...) hoặc MongoDB nội bộ
MONGODB_DB_NAME=meeting_assistant
SONIOX_API_KEY=                     # nhận dạng giọng nói
LLM_PROVIDER=claude
CLAUDE_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=                  # biên bản, trợ lý, Bảng BD, tra mạng
GOOGLE_OAUTH_CLIENT_ID=             # đăng nhập Google, Drive, Lịch; redirect URI = <PUBLIC_BASE_URL>/api/google/callback
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_TOKEN_KEY=                   # khóa mã hóa token Google lưu trong DB (openssl rand -hex 32)

# --- Bot vào Google Meet / Teams / Zoom (Recall.ai) ---
RECALLAI_API_KEY=
RECALL_REGION=                      # để trống: tự dò vùng của key

# --- Kho tri thức WikiBox ---
WIKIBOX_URL=https://wiki.urbox.vn
WIKIBOX_TOKEN_KEY=                  # khóa mã hóa token WikiBox (openssl rand -hex 32)

# --- Tùy chọn ---
RECORDING_RETENTION_DAYS=30
TTS_ENGINE=                         # để trống: tự chọn (Soniox TTS nếu có, không thì giọng đọc trên server)
INTERVIEW_ADMIN_EMAILS=             # quản trị chế độ Phỏng vấn (mặc định dùng AUTH_ADMIN_EMAILS)
