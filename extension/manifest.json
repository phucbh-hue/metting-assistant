{
  "manifest_version": 3,
  "name": "UrBox Meeting Copilot - thu tiếng tab",
  "version": "0.1.0",
  "description": "Nghe tiếng cuộc họp online qua tab trình duyệt rồi gửi về Meeting Copilot để chép lời, không cần bot vào phòng.",
  "permissions": ["tabCapture", "offscreen", "storage", "scripting", "tabs"],
  "host_permissions": [
    "https://urbox-meeting-api.onrender.com/*",
    "http://localhost:8080/*",
    "http://127.0.0.1:8080/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [{
    "matches": [
      "https://urbox-meeting-api.onrender.com/*",
      "http://localhost:8080/*",
      "http://127.0.0.1:8080/*"
    ],
    "js": ["token-bridge.js"],
    "run_at": "document_idle"
  }],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Meeting Copilot - thu tiếng tab" }
}
