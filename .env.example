# ==============================================================================
# Meeting Assistant AI - Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your actual API keys.

# --- LLM Provider ---
LLM_PROVIDER=claude                    # "claude" or "gemini"
AGENT_MODEL=gemini-3.6-flash
CLAUDE_MODEL=claude-sonnet-5

# --- API Keys ---
ANTHROPIC_API_KEY=sk-ant-api03-xxxxx   # Claude API key
GEMINI_API_KEY=your-gemini-key         # Google Gemini API key
SONIOX_API_KEY=your-soniox-key         # Soniox Realtime STT key

# --- MongoDB Atlas ---
MONGODB_URL="mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME=meeting_assistant

# --- Optional ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
PUBLIC_WS_BASE=
ALLOWED_DOMAIN=urbox.vn
