# ==============================================================================
# Meeting Assistant AI - Environment Configuration
# ==============================================================================
# Sao chép file này thành .env rồi điền API key thật. Không commit file .env.

# --- LLM ---
# Nguồn AI (đổi được trong Cài đặt, lựa chọn trong Cài đặt được ưu tiên hơn biến này):
#   claude / gemini           = API key (tính tiền theo token)
#   claude-cli                = gói Claude.ai (Pro, Max, Team) qua Claude Code, cần đăng nhập: claude rồi /login
#   codex-cli                 = gói ChatGPT (Plus, Pro, Business) qua Codex CLI, cần: codex login
#   gemini-cli                = tài khoản Google qua Gemini CLI, cần: gemini rồi chọn Login with Google
LLM_PROVIDER=claude
AGENT_MODEL=gemini-3.6-flash
CLAUDE_MODEL=claude-sonnet-5-5            # model Claude API mặc định; đổi từng nguồn trong Cài đặt > Nguồn AI (có danh sách)
ANTHROPIC_API_KEY=sk-ant-api03-xxxxx
GEMINI_API_KEY=your-gemini-key
# LLM_API_FALLBACK=0                   # 1 = gói đăng ký lỗi / hết hạn mức thì gọi tiếp bằng API key (có tính phí)
# CLAUDE_CLI_MODEL=sonnet              # model cho claude-cli: sonnet, opus, haiku hoặc tên đầy đủ (Opus tốn hạn mức nhanh)
# CLAUDE_CLI_EFFORT=medium             # low / medium / high
# CODEX_MODEL=                         # để trống = model mặc định của gói ChatGPT
# CODEX_EFFORT=medium
# GEMINI_CLI_MODEL=                    # để trống = model mặc định của Gemini CLI
# CLI_LLM_TIMEOUT=240                  # giây chờ tối đa mỗi lần gọi CLI
# CLI_LLM_CONCURRENCY=3                # số lời gọi CLI chạy cùng lúc

# --- Nhận dạng giọng nói (Soniox Realtime) ---
SONIOX_API_KEY=your-soniox-key
SONIOX_MODEL=stt-rt-v5
SONIOX_LANGUAGE_HINTS=vi,en
SONIOX_IDLE_CLOSE_S=30                 # Tắt mic quá ngần này giây thì đóng stream (Soniox tính phí theo thời gian mở)

# --- Định danh người nói ---
VOICE_MODEL_PATH=models/speaker.onnx   # Model CAM++ 192D (sherpa-onnx)
AUTO_ENROLL_VOICES=0                   # 1 = tự lưu mẫu giọng khi AI đoán tên >= 85% (cần người tham dự đồng ý - NĐ 13/2023)
IDENTITY_MIN_INTERVAL_S=20             # Khoảng cách tối thiểu (giây) giữa 2 lần AI đoán tên trong lúc họp
IDENTITY_FALLBACK_SEGMENTS=40          # Không có tên mới được nhắc thì cứ bấy nhiêu câu mới đoán lại tên một lần

# --- MongoDB ---
MONGODB_URL="mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME=meeting_assistant
MEETING_DB=                            # Để trống = MongoDB (lỗi kết nối thì lưu trên máy ở data/local_db). "mock" = in-memory (test), "local" = chỉ lưu trên máy
# LOCAL_DB_DIR=data/local_db           # Thư mục lưu trên máy khi không kết nối được Atlas

# --- Tra cứu trên mạng ---
WEB_SEARCH_PROVIDER=auto               # auto = trình duyệt Playwright (Bing), lỗi thì Claude web_search; playwright; claude
WEB_SEARCH_PAGES=4                     # Số trang kết quả mở đọc mỗi lần tra cứu

# --- Tài liệu trên máy (mở PDF, PowerPoint, Word để trình bày) ---
# Mặc định tìm trong slides/, Desktop, Documents, Downloads, OneDrive; thêm thư mục khác trong Cài đặt hoặc ở đây
# LIBRARY_DIRS=D:\Tai lieu;E:\Thuyet trinh   # nhiều thư mục cách nhau bằng dấu ; (Windows) hoặc : (macOS / Linux)
# LIBRARY_DEFAULTS=1                   # 0 = không tìm trong Desktop / Documents / Downloads / OneDrive
# DECK_MAX_PAGES=60                    # số trang tối đa đọc từ một tệp
# DECK_ASSETS_DIR=data/deck_assets     # nơi lưu ảnh từng trang PDF / slide đã dựng

# --- Tùy chọn ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
PUBLIC_WS_BASE=
ALLOWED_DOMAIN=urbox.vn

# MCP data server thật (mcp_server/): bỏ comment một trong hai dòng để trợ lý tra cứu qua MCP thay vì dữ liệu tại chỗ
# MCP_SERVER_CMD=python -m mcp_server
# MCP_SERVER_URL=http://127.0.0.1:8765/mcp
